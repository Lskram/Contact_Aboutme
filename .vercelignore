# Ignore Django backend and Python files when deploying static site to Vercel
# Keep the api/ folder itself so Vercel can run the Tailwind build (api/package.json, api/assets, api/static)
api/**/*.py
api/**/__pycache__/
api/**/migrations/
api/db.sqlite3
manage.py
requirements.txt
.venv/
__pycache__/

# Node artifacts we don't want in repo root
node_modules/
npm-debug.log
package-lock.json

# Optional build artifacts
static/
staticfiles/
